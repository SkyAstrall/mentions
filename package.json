{
	"name": "mentions",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"test": "vitest",
		"test:e2e": "playwright test",
		"size": "size-limit",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm build && changeset publish && git push --follow-tags",
		"deploy": "pnpm build && cd website && pnpm build && wrangler pages deploy dist --project-name skyastrall-mentions --branch main --commit-dirty=true"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@changesets/cli": "^2.29.0",
		"@playwright/test": "^1.58.2",
		"@size-limit/preset-small-lib": "^12.1.0",
		"jsdom": "^29.0.1",
		"publint": "^0.3.18",
		"size-limit": "^12.1.0",
		"tsdown": "^0.9.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	}
}
