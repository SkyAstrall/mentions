{
	"name": "@skyastrall/mentions-core",
	"version": "0.5.0",
	"type": "module",
	"description": "Framework-agnostic engine for trigger detection, markup parsing, and mention state management. Zero dependencies.",
	"license": "MIT",
	"author": "SkyAstrall",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SkyAstrall/mentions.git",
		"directory": "packages/core"
	},
	"homepage": "https://mentions.skyastrall.com",
	"bugs": {
		"url": "https://github.com/SkyAstrall/mentions/issues"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./dist/effects.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./effects.css": "./dist/effects.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown && cp ./src/effects.css ./dist/effects.css && npx publint"
	},
	"keywords": [
		"mentions",
		"mention",
		"autocomplete",
		"autosuggest",
		"typeahead",
		"combobox",
		"trigger",
		"at-mention",
		"hashtag",
		"slash-commands",
		"textarea-autocomplete",
		"mention-input",
		"headless",
		"framework-agnostic",
		"vanilla-js",
		"input"
	]
}
